# Copy this file to ".env" (same directory as main.go / the compiled
# binary) and fill in your values. Real environment variables, if set,
# always override whatever is in this file.
 
GOFLOW_SUBDOMAIN=companyname
GOFLOW_API_TOKEN=
 
# Optional - leave blank/omit to skip tracking checks for that carrier.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
 
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
 
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=

# Stamps.com/Endicia (SERA) - an alternative to USPS_CLIENT_ID/SECRET above
# for checking "usps" tracking. CLIENT_ID/CLIENT_SECRET are required
# together; if either is missing, Stamps.com is skipped and the native USPS
# API above (if configured) is used instead. If both are fully configured,
# Stamps.com takes priority.
#
# REFRESH_TOKEN is optional. If you already have one, set it here and
# tracker uses it right away. If you leave it blank, tracker will log you
# in interactively the first time it needs a token: it prints a
# signin.stampsendicia.com URL to open in a browser, waits for you to log
# in, and caches the resulting access/refresh tokens in memory for the rest
# of that run only (nothing is written back to this file automatically) -
# it also prints the refresh token once so you can paste it in below
# yourself, if you'd rather not log in again next time. This requires
# REDIRECT_URI (or its default, http://localhost:8080/callback) to be
# registered as a valid redirect URI for CLIENT_ID in the Stamps.com/
# Endicia developer console first, or the login will fail.
STAMPS_CLIENT_ID=
STAMPS_CLIENT_SECRET=
STAMPS_REFRESH_TOKEN=
# Optional - defaults to http://localhost:8080/callback. Must exactly
# match a redirect URI registered for STAMPS_CLIENT_ID.
STAMPS_REDIRECT_URI=

# Amazon Shipping (SP-API) - all three are required together; if any one is
# missing, Amazon Shipping tracking checks are skipped.
AMAZON_SHIPPING_CLIENT_ID=
AMAZON_SHIPPING_CLIENT_SECRET=
AMAZON_SHIPPING_REFRESH_TOKEN=
# Optional - defaults to the North America SP-API endpoint.
AMAZON_SHIPPING_ENDPOINT=